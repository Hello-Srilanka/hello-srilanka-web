# Server only. Leave empty to use the clearly labelled sample mode.
OPENAI_API_KEY=
# Full-AI itinerary defaults: live research, followed by structured composition.
# Both models must support the Responses API; research also requires web_search.
OPENAI_RESEARCH_MODEL=gpt-6-sol
OPENAI_COMPOSE_MODEL=gpt-6-sol
OPENAI_RESEARCH_REASONING=low
OPENAI_COMPOSE_REASONING=medium
# Optional compatibility override used only when a stage-specific model is absent.
# OPENAI_MODEL=gpt-6-sol
# Optional: force sample mode even when a key is available.
# ITINERARY_MODE=sample
# Optional shared persistent directory for request deduplication (default: OS tmpdir).
# ITINERARY_CACHE_DIR=/var/lib/hellosrilanka/itineraries
